{
  "name": "@dsudomoin/weeek-mcp",
  "version": "0.2.0",
  "description": "MCP server for the Weeek Public API: tasks, comments, attachments",
  "type": "module",
  "license": "MIT",
  "bin": {
    "weeek-mcp": "dist/server.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsudomoin/weeek-mcp.git"
  },
  "homepage": "https://github.com/dsudomoin/weeek-mcp",
  "bugs": {
    "url": "https://github.com/dsudomoin/weeek-mcp/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "weeek",
    "tasks",
    "claude",
    "codex"
  ],
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "test": "node --test 'src/**/*.test.ts'",
    "update:openapi": "node scripts/update-openapi.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "26.4.0",
    "@types/turndown": "5.0.6",
    "esbuild": "0.28.2",
    "marked": "18.0.11",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "7.0.2",
    "zod": "4.4.3"
  }
}
